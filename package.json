{
  "name": "apify-router",
  "version": "0.1.0",
  "description": "One endpoint in front of many Apify API keys: picks a key with balance left, retries on the next one when credits run out.",
  "type": "module",
  "engines": { "node": ">=20" },
  "license": "MIT",
  "bin": {
    "apify-router-rules": "scripts/install-rules.mjs"
  },
  "scripts": {
    "dev": "tsx src/node.ts",
    "start": "tsx src/node.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "rules": "node scripts/install-rules.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0",
    "tsx": "^4.19.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
