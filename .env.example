# One Apify token per line (or comma separated), or a JSON array:
#   [{"token":"...","label":"main","limitUsd":5}]
APIFY_KEYS=

# Any long random string. Clients send this instead of an Apify token.
ROUTER_TOKEN=

# fill = use keys in order until one runs low; balanced = always the key with the most balance left
STRATEGY=fill

# Skip a key when its remaining monthly balance is below this many USD
MIN_HEADROOM_USD=0.5

# How long a key rests after Apify says it is out of credits
COOLDOWN_SEC=3600

PORT=8787
